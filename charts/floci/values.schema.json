{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Floci chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "hookScripts": {
      "type": ["object", "null"],
      "additionalProperties": { "type": "string" }
    },
    "probe": {
      "type": ["object", "null"]
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "variant": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "floci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^$|^https?://" },
        "hostname": { "type": "string" },
        "clusterDomain": { "type": "string", "minLength": 1 },
        "defaultRegion": { "type": "string" },
        "defaultAccountId": {
          "description": "A string, so leading zeros survive; quote it in YAML.",
          "type": "string",
          "pattern": "^$|^[0-9]{12}$"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["", "memory", "persistent", "hybrid", "wal"] }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "lambda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executor": { "type": "string", "enum": ["docker", "kubernetes"] },
            "kubernetes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespace": { "type": "string" },
                "initImage": { "type": "string" },
                "labels": { "type": "array", "items": { "type": "string", "pattern": "^[^=,]+=[^,]*$" } },
                "flociAddress": { "type": "string", "pattern": "^$|^[A-Za-z0-9.-]+$" }
              }
            }
          }
        },
        "env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "initHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boot": { "$ref": "#/definitions/hookScripts" },
        "start": { "$ref": "#/definitions/hookScripts" },
        "ready": { "$ref": "#/definitions/hookScripts" },
        "stop": { "$ref": "#/definitions/hookScripts" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "dataSizeLimit": { "type": "string" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "string"] },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "portRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "start", "end"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$" },
              "start": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "end": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "extraPorts": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podSecurityContext": { "type": ["object", "null"] },
    "securityContext": { "type": ["object", "null"] },
    "resources": { "type": ["object", "null"] },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "extraVolumes": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object", "required": ["name", "mountPath"] } },
    "helperImage": { "$ref": "#/definitions/image" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lambda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    }
  }
}
