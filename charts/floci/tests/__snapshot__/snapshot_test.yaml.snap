matches the default manifests:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: floci
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: floci
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: floci-0.0.0
      name: floci
      namespace: aws
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/instance: floci
          app.kubernetes.io/name: floci
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: floci
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: floci
            app.kubernetes.io/version: 0.0.0
            helm.sh/chart: floci-0.0.0
        spec:
          automountServiceAccountToken: true
          containers:
            - env:
                - name: FLOCI_BASE_URL
                  value: http://floci.aws.svc.cluster.local:4566
                - name: FLOCI_PORT
                  value: "4566"
                - name: FLOCI_SERVICES_LAMBDA_EXECUTOR
                  value: kubernetes
                - name: FLOCI_SERVICES_LAMBDA_KUBERNETES_NAMESPACE
                  value: aws
                - name: FLOCI_STORAGE_MODE
                  value: memory
                - name: FLOCI_STORAGE_PERSISTENT_PATH
                  value: /app/data
              image: floci/floci:0.0.0
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /_floci/health
                  port: http
                periodSeconds: 10
                timeoutSeconds: 3
              name: floci
              ports:
                - containerPort: 4566
                  name: http
                  protocol: TCP
              readinessProbe:
                exec:
                  command:
                    - /bin/bash
                    - -c
                    - 'exec 3<>/dev/tcp/127.0.0.1/4566 && printf ''GET /_floci/init HTTP/1.0\r\nHost: localhost\r\n\r\n'' >&3 && { IFS= read -r -d '''' response <&3; [[ $response == "HTTP/1."?" 200"*''"ready":true''* ]]; }'
                failureThreshold: 3
                periodSeconds: 5
                timeoutSeconds: 3
              resources:
                limits:
                  memory: 1Gi
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
              startupProbe:
                failureThreshold: 60
                httpGet:
                  path: /_floci/health
                  port: http
                periodSeconds: 2
                timeoutSeconds: 3
              volumeMounts:
                - mountPath: /app/data
                  name: data
                - mountPath: /tmp
                  name: tmp
          enableServiceLinks: false
          securityContext:
            fsGroup: 1001
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 1001
            runAsNonRoot: true
            runAsUser: 1001
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: floci
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir: {}
              name: data
            - emptyDir: {}
              name: tmp
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: Role
    metadata:
      labels:
        app.kubernetes.io/instance: floci
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: floci
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: floci-0.0.0
      name: floci-lambda
      namespace: aws
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - create
          - get
          - list
          - delete
      - apiGroups:
          - ""
        resources:
          - pods/log
        verbs:
          - get
      - apiGroups:
          - ""
        resourceNames:
          - floci-lambda-ca
        resources:
          - configmaps
        verbs:
          - delete
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: RoleBinding
    metadata:
      labels:
        app.kubernetes.io/instance: floci
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: floci
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: floci-0.0.0
      name: floci-lambda
      namespace: aws
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: Role
      name: floci-lambda
    subjects:
      - kind: ServiceAccount
        name: floci
        namespace: aws
  4: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app.kubernetes.io/instance: floci
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: floci
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: floci-0.0.0
      name: floci
      namespace: aws
    spec:
      ports:
        - name: http
          port: 4566
          protocol: TCP
          targetPort: http
      selector:
        app.kubernetes.io/instance: floci
        app.kubernetes.io/name: floci
      type: ClusterIP
  5: |
    apiVersion: v1
    automountServiceAccountToken: false
    kind: ServiceAccount
    metadata:
      labels:
        app.kubernetes.io/instance: floci
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: floci
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: floci-0.0.0
      name: floci
      namespace: aws
