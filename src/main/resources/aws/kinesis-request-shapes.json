    },
    "ShardId": {
      "type": "string",
      "min": 1,
      "max": 128,
      "pattern": "[a-zA-Z0-9_.-]+"
    },
    "ShardIterator": {
      "type": "string",
      "min": 1,
      "max": 512
    },
    "ShardIteratorType": {
      "type": "string",
      "enum": [
        "AT_SEQUENCE_NUMBER",
        "AFTER_SEQUENCE_NUMBER",
        "TRIM_HORIZON",
        "LATEST",
        "AT_TIMESTAMP"
      ]
    },
    "SplitShardInput": {
      "type": "structure",
      "required": [
        "ShardToSplit",
        "NewStartingHashKey"
      ],
      "members": {
        "StreamName": "StreamName",
        "ShardToSplit": "ShardId",
        "NewStartingHashKey": "HashKey",
        "StreamARN": "StreamARN",
        "StreamId": "StreamId"
      }
    },
    "StartStreamEncryptionInput": {
      "type": "structure",
      "required": [
        "EncryptionType",
        "KeyId"
      ],
      "members": {
        "StreamName": "StreamName",
        "EncryptionType": "EncryptionType",
        "KeyId": "KeyId",
        "StreamARN": "StreamARN",
        "StreamId": "StreamId"
      }
    },
    "StartingPosition": {
      "type": "structure",
      "required": [
        "Type"
      ],
      "members": {
        "Type": "ShardIteratorType",
        "SequenceNumber": "SequenceNumber"
      }
    },
    "StopStreamEncryptionInput": {
      "type": "structure",
      "required": [
        "EncryptionType",
        "KeyId"
      ],
      "members": {
        "StreamName": "StreamName",
        "EncryptionType": "EncryptionType",
        "KeyId": "KeyId",
        "StreamARN": "StreamARN",
        "StreamId": "StreamId"
      }
    },
    "StreamARN": {
      "type": "string",
      "min": 1,
      "max": 2048,
      "pattern": "arn:aws.*:kinesis:.*:\\d{12}:stream/\\S+"
    },
    "StreamFilter": {
      "type": "structure",
      "required": [
        "StreamARN"
      ],
      "members": {
        "StreamARN": "StreamARN"
      }
    },
    "StreamFilterList": {
      "type": "list",
      "min": 1,
      "max": 10000,
      "member": "StreamFilter"
    },
    "StreamId": {
      "type": "string",
      "min": 1,
      "max": 24,
      "pattern": "[a-z0-9]{20}-[a-z0-9]{3}"
    },
    "StreamMode": {
      "type": "string",
      "enum": [
        "PROVISIONED",
        "ON_DEMAND"
      ]
    },
    "StreamModeDetails": {
      "type": "structure",
      "required": [
        "StreamMode"
      ],
      "members": {
        "StreamMode": "StreamMode"
      }
    },
    "StreamName": {
      "type": "string",
      "min": 1,
      "max": 128,
      "pattern": "[a-zA-Z0-9_.-]+"
    },
    "SubscribeToShardInput": {
      "type": "structure",
      "required": [
        "ConsumerARN",
        "ShardId",
        "StartingPosition"
      ],
      "members": {
        "ConsumerARN": "ConsumerARN",
        "StreamId": "StreamId",
        "ShardId": "ShardId",
        "StartingPosition": "StartingPosition",
        "DryRun": "BooleanObject"
      }
    },
    "TableBucketARN": {
      "type": "string",
      "min": 1,
      "max": 2048,
      "pattern": "arn:aws[-a-z0-9]*:s3tables:[-a-z0-9]+:\\d{12}:bucket/[a-z0-9_-]{3,63}"
    },
    "TagKey": {
      "type": "string",
      "min": 1,
      "max": 128
    },
    "TagKeyList": {
      "type": "list",
      "min": 1,
      "max": 50,
      "member": "TagKey"
    },
    "TagMap": {
      "type": "map",
      "min": 1,
      "max": 200,
      "key": "TagKey",
      "value": "TagValue"
    },
    "TagResourceInput": {
      "type": "structure",
      "required": [
        "Tags",
        "ResourceARN"
      ],
      "members": {
        "Tags": "TagMap",
        "ResourceARN": "ResourceARN",
        "StreamId": "StreamId"
      }
    },
    "TagValue": {
      "type": "string",
      "min": 0,
      "max": 256
    },
    "UntagResourceInput": {
      "type": "structure",
      "required": [
        "TagKeys",
        "ResourceARN"
      ],
      "members": {
        "TagKeys": "TagKeyList",
        "ResourceARN": "ResourceARN",
        "StreamId": "StreamId"
      }
    },
    "UpdateAccountSettingsInput": {
      "type": "structure",
      "required": [
        "MinimumThroughputBillingCommitment"
      ],
      "members": {
        "MinimumThroughputBillingCommitment": "MinimumThroughputBillingCommitmentInput"
      }
    },
    "UpdateChannelInput": {
      "type": "structure",
      "required": [
        "ChannelARN"
      ],
      "members": {
        "ChannelARN": "ChannelARN",
        "S3DestinationConfiguration": "S3DestinationUpdateInput",
        "S3TablesDestinationConfiguration": "S3TablesDestinationUpdateInput",
        "LoggingConfiguration": "ChannelLoggingUpdateInput"
      }
    },
    "UpdateMaxRecordSizeInput": {
      "type": "structure",
      "required": [
        "MaxRecordSizeInKiB"
      ],
      "members": {
        "StreamARN": "StreamARN",
        "StreamId": "StreamId",
        "MaxRecordSizeInKiB": "MaxRecordSizeInKiB"
      }
    },
    "UpdateShardCountInput": {
      "type": "structure",
      "required": [
        "TargetShardCount",
        "ScalingType"
      ],
      "members": {
        "StreamName": "StreamName",
        "TargetShardCount": "PositiveIntegerObject",
        "ScalingType": "ScalingType",
        "StreamARN": "StreamARN",
        "StreamId": "StreamId"
      }
    },
    "UpdateStreamModeInput": {
      "type": "structure",
      "required": [
        "StreamARN",
        "StreamModeDetails"
      ],
      "members": {
        "StreamARN": "StreamARN",
        "StreamId": "StreamId",
        "StreamModeDetails": "StreamModeDetails",
        "WarmThroughputMiBps": "NaturalIntegerObject"
      }
    },
    "UpdateStreamRecordDistributionStrategyInput": {
      "type": "structure",
      "required": [
        "StreamARN",
        "RecordDistributionStrategy"
      ],
      "members": {
        "StreamARN": "StreamARN",
        "StreamId": "StreamId",
        "RecordDistributionStrategy": "RecordDistributionStrategy"
      }
    },
    "UpdateStreamWarmThroughputInput": {
      "type": "structure",
      "required": [
        "WarmThroughputMiBps"
      ],
      "members": {
        "StreamARN": "StreamARN",
        "StreamName": "StreamName",
        "StreamId": "StreamId",
        "WarmThroughputMiBps": "NaturalIntegerObject"
      }
    }
  }
}
