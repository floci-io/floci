    "OptionalBlocks": {
      "type": "map",
      "key": "OptionalBlockId",
      "value": "OptionalBlockValue"
    },
    "PrimitiveBoolean": {
      "type": "boolean"
    },
    "PutResourcePolicyInput": {
      "type": "structure",
      "required": [
