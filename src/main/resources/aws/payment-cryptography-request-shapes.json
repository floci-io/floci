        "KeyArn": "KeyArn"
      }
    },
    "WrappedKeyCryptogram": {
      "type": "string",
      "min": 16,
      "max": 4096,
      "pattern": "[0-9A-F]+"
    },
    "WrappingKeySpec": {
      "type": "string",
      "enum": [
