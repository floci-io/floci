        "Policy"
      ],
      "members": {
        "ResourceArn": "ResourceArn",
        "Policy": "ResourcePolicy"
      }
    },
    "Region": {
      "type": "string",
      "pattern": "[a-z]{2,4}(-[a-z]{1,16})+-[0-9]+"
    },
    "Regions": {
      "type": "list",
      "member": "Region"
    },
    "RemoveKeyReplicationRegionsInput": {
      "type": "structure",
      "required": [
        "KeyIdentifier",
        "ReplicationRegions"
      ],
      "members": {
        "KeyIdentifier": "KeyArnOrKeyAliasType",
        "ReplicationRegions": "Regions"
      }
    },
    "ResourceArn": {
      "type": "string",
      "min": 70,
      "max": 150,
      "pattern": "arn:aws[a-z0-9-]*:payment-cryptography:[a-z]{2,4}(-[a-z]{1,16})+-[0-9]+:[0-9]{12}:key/[0-9a-zA-Z]{16,64}"
    },
    "ResourcePolicy": {
      "type": "string",
      "min": 1,
      "max": 20480,
      "pattern": "[\\u0009\\u000A\\u000D\\u0020-\\u00FF]+"
    },
    "RestoreKeyInput": {
      "type": "structure",
      "required": [
        "KeyIdentifier"
      ],
      "members": {
        "KeyIdentifier": "KeyArnOrKeyAliasType"
      }
    },
    "RootCertificatePublicKey": {
      "type": "structure",
      "required": [
        "KeyAttributes",
        "PublicKeyCertificate"
      ],
      "members": {
        "KeyAttributes": "KeyAttributes",
        "PublicKeyCertificate": "CertificateType"
      }
    },
    "SharedInformation": {
      "type": "string",
      "min": 2,
      "max": 2048,
      "pattern": "(?:[0-9a-fA-F][0-9a-fA-F])+"
    },
    "SigningAlgorithmType": {
      "type": "string",
      "enum": [
        "SHA224",
        "SHA256",
        "SHA384",
        "SHA512"
      ]
    },
    "StartKeyUsageInput": {
      "type": "structure",
      "required": [
        "KeyIdentifier"
      ],
      "members": {
        "KeyIdentifier": "KeyArnOrKeyAliasType"
      }
    },
    "StopKeyUsageInput": {
      "type": "structure",
      "required": [
        "KeyIdentifier"
      ],
      "members": {
        "KeyIdentifier": "KeyArnOrKeyAliasType"
      }
    },
    "SymmetricKeyAlgorithm": {
      "type": "string",
      "enum": [
        "TDES_2KEY",
        "TDES_3KEY",
        "AES_128",
        "AES_192",
        "AES_256",
        "HMAC_SHA256",
        "HMAC_SHA384",
        "HMAC_SHA512",
        "HMAC_SHA224"
      ]
    },
    "Tag": {
      "type": "structure",
      "required": [
        "Key",
        "Value"
      ],
      "members": {
        "Key": "TagKey",
        "Value": "TagValue"
      }
    },
    "TagKey": {
      "type": "string",
      "min": 1,
      "max": 128
    },
    "TagKeys": {
      "type": "list",
      "min": 0,
      "max": 200,
      "member": "TagKey"
    },
    "TagResourceInput": {
      "type": "structure",
      "required": [
        "ResourceArn",
        "Tags"
      ],
      "members": {
        "ResourceArn": "ResourceArn",
        "Tags": "Tags"
      }
    },
    "TagValue": {
      "type": "string",
      "min": 1,
      "max": 256
    },
    "Tags": {
      "type": "list",
      "min": 0,
      "max": 200,
      "member": "Tag"
    },
    "Tr31WrappedKeyBlock": {
      "type": "string",
      "min": 56,
      "max": 9984,
      "pattern": "[0-9a-zA-Z]+"
    },
    "Tr34KeyBlockFormat": {
      "type": "string",
      "enum": [
        "X9_TR34_2012"
      ]
    },
    "Tr34WrappedKeyBlock": {
      "type": "string",
      "min": 2,
      "max": 4096,
      "pattern": "[0-9A-F]+"
    },
    "TrustedCertificatePublicKey": {
      "type": "structure",
      "required": [
        "KeyAttributes",
        "PublicKeyCertificate",
        "CertificateAuthorityPublicKeyIdentifier"
      ],
      "members": {
        "KeyAttributes": "KeyAttributes",
        "PublicKeyCertificate": "CertificateType",
        "CertificateAuthorityPublicKeyIdentifier": "KeyArnOrKeyAliasType"
      }
    },
    "UntagResourceInput": {
      "type": "structure",
      "required": [
        "ResourceArn",
        "TagKeys"
