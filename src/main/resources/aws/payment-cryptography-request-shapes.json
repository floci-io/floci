      "pattern": "arn:aws(-[^:]+)?:mpa:[a-z0-9-]{1,20}:[0-9]{12}:approval-team/[a-zA-Z0-9._-]+"
    },
    "NextToken": {
      "type": "string",
      "min": 1,
      "max": 8192
    },
    "OptionalBlockId": {
      "type": "string",
      "min": 2,
      "max": 2,
      "pattern": "[0-9A-Z]{2}+"
    },
    "OptionalBlockValue": {
      "type": "string",
      "min": 1,
      "max": 108,
      "pattern": "[0-9a-zA-Z]+"
