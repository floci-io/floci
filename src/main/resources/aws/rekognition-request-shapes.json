        "ConnectedHomeForUpdate": "ConnectedHomeSettingsForUpdate"
      }
    },
    "TagKey": {
      "type": "string",
      "min": 1,
      "max": 128,
      "pattern": "^(?!aws:)[\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*$"
    },
    "TagKeyList": {
      "type": "list",
      "min": 0,
      "max": 200,
      "member": "TagKey"
    },
    "TagMap": {
      "type": "map",
      "min": 0,
      "max": 200,
      "key": "TagKey",
      "value": "TagValue"
    },
    "TagResourceRequest": {
      "type": "structure",
      "required": [
        "ResourceArn",
        "Tags"
      ],
      "members": {
        "ResourceArn": "ResourceArn",
        "Tags": "TagMap"
      }
    },
    "TagValue": {
      "type": "string",
      "min": 0,
      "max": 256,
      "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$"
    },
    "TestingData": {
      "type": "structure",
      "members": {
        "Assets": "Assets",
        "AutoCreate": "Boolean"
      }
    },
    "TrainingData": {
      "type": "structure",
      "members": {
        "Assets": "Assets"
      }
    },
    "UInteger": {
      "type": "integer",
      "min": 0
    },
    "ULong": {
      "type": "long",
      "min": 0
    },
    "UntagResourceRequest": {
      "type": "structure",
      "required": [
        "ResourceArn",
        "TagKeys"
      ],
      "members": {
        "ResourceArn": "ResourceArn",
        "TagKeys": "TagKeyList"
      }
    },
    "UpdateDatasetEntriesRequest": {
      "type": "structure",
      "required": [
        "DatasetArn",
        "Changes"
      ],
      "members": {
        "DatasetArn": "DatasetArn",
        "Changes": "DatasetChanges"
      }
    },
    "UpdateStreamProcessorRequest": {
      "type": "structure",
      "required": [
        "Name"
      ],
      "members": {
        "Name": "StreamProcessorName",
        "SettingsForUpdate": "StreamProcessorSettingsForUpdate",
        "RegionsOfInterestForUpdate": "RegionsOfInterest",
        "DataSharingPreferenceForUpdate": "StreamProcessorDataSharingPreference",
        "ParametersToDelete": "StreamProcessorParametersToDelete"
      }
    },
    "UserFaceIdList": {
      "type": "list",
      "min": 1,
      "max": 100,
      "member": "FaceId"
    },
    "UserId": {
      "type": "string",
      "min": 1,
      "max": 128,
      "pattern": "[a-zA-Z0-9_.\\-:]+"
    },
    "Version": {
      "type": "string",
      "min": 5,
      "max": 11,
      "pattern": "^(0|[1-9]\\d{0,2})\\.(0|[1-9]\\d{0,2})\\.(0|[1-9]\\d{0,2})$"
    },
    "VersionDescription": {
      "type": "string",
      "min": 1,
      "max": 255,
      "pattern": "[a-zA-Z0-9-_. ()':,;?]+"
    },
    "VersionName": {
      "type": "string",
      "min": 1,
      "max": 255,
      "pattern": "[a-zA-Z0-9_.\\-]+"
    },
    "VersionNames": {
      "type": "list",
      "min": 1,
      "max": 10,
      "member": "VersionName"
    },
    "Versions": {
      "type": "structure",
      "members": {
        "Minimum": "Version",
        "Maximum": "Version"
      }
    },
    "Video": {
      "type": "structure",
      "members": {
        "S3Object": "S3Object"
      }
    }
  }
}
